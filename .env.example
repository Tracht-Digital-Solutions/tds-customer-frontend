# tds-customer-frontend — build environment
#
# Copy to `.env` (gitignored) before `npm run dev` or `npm run build`.
#
# THIS IS THE DIFFERENCE FROM THE PUBLIC SITES: these values are compiled into
# the bundle at BUILD TIME. A deployed portal cannot be pointed at a different
# API — it deliberately never reads `tds-runtime.json`. See "Bind it to an API"
# in README.md.
#
# With no `.env` the portal builds against production. That is the default and
# exactly right for the normal case; the lines below are only for building
# against a local or staging stack.

# --- Bind it to an API -----------------------------------------------------

# Gateway origin, NO path. Becomes <meta name="tds-api-base"> in the shell;
# `apiFetch` from tds-shared resolves every extension call against it.
# Unset == https://api.tracht-digital.de
# PUBLIC_API_BASE=http://localhost:8080

# tds-auth-api, WITH the gateway's /auth prefix. The shell checks the session
# (`GET /me`) and renews it (`POST /refresh`) here.
# Unset == https://api.tracht-digital.de/auth
# PUBLIC_AUTH_API_URL=http://localhost:8080/auth

# The central login site. Logged-out visitors are bounced there with
# `?next=<absolute return URL>`; the login site allows `localhost` and
# `*.tracht-digital.de` back, nothing else.
# Unset == https://auth.tracht-digital.de
# PUBLIC_LOGIN_URL=http://localhost:4326

# --- Do not set ------------------------------------------------------------
#
# PUBLIC_FRONTEND_TARGET is set to "customer" by this repo's own
# astro.config.mjs. Overridden in the build environment, this product builds as
# the ADMIN PANEL: different accent, different localStorage hint keys,
# different wordmark — carrying the portal's extension set. The build stays
# green. There is no reason to do it.

# --- shell-only (NOT in this file) -----------------------------------------
# NPM_TOKEN authenticates against GitHub Packages (host + extensions). npm does
# not load `.env`, so it belongs in the shell:
#   PowerShell:  $env:NPM_TOKEN = "ghp_…"
#   bash/zsh:    export NPM_TOKEN=ghp_…
